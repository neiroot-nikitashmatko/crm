VITE_API_BASE_URL=http://localhost:8080

# Моковые чаты для раздела «Чаты»:
# - в npm run dev моки включены по умолчанию (добавляются к реальным чатам)
# - true  — только моки
# - false — моки выключены
# VITE_MOCK_AVITO_CHATS=false

